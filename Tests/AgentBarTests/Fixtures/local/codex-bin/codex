#!/bin/sh
# A stand-in for `codex app-server` in tests: answers the three requests AgentBar sends, one JSON
# object per line, with whatever CODEX_ACCOUNT and CODEX_RATE_LIMITS hold (default {}). With
# CODEX_SILENT set it reads and never answers. CODEX_ARGS_FILE receives the arguments, one per line.
[ -n "$CODEX_ARGS_FILE" ] && printf '%s\n' "$@" > "$CODEX_ARGS_FILE"
if [ -n "$CODEX_SILENT" ]; then
  cat > /dev/null
  exit 0
fi
account=${CODEX_ACCOUNT-}
[ -n "$account" ] || account='{}'
limits=${CODEX_RATE_LIMITS-}
[ -n "$limits" ] || limits='{}'
while IFS= read -r request; do
  id=$(printf '%s' "$request" | sed -n 's/.*"id"[[:space:]]*:[[:space:]]*\([0-9][0-9]*\).*/\1/p')
  method=$(printf '%s' "$request" | sed -n 's/.*"method"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p')
  case "$method" in
    initialize)
      echo '{"method":"codex/event","params":{"note":"unrelated line the client must skip"}}'
      printf '{"id":%s,"result":{}}\n' "$id" ;;
    account/read)
      printf '{"id":%s,"result":{"account":%s}}\n' "$id" "$account" ;;
    account/rateLimits/read)
      printf '{"id":%s,"result":{"rateLimits":%s}}\n' "$id" "$limits" ;;
  esac
done
